{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mosaico Ideas external project upload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "content"],
  "properties": {
    "schema": {"const": "mosaico-ideas/project-upload/v1"},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "categories"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "categories": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["smart-home", "sensors", "display", "audio", "communication", "motor"]}},
        "boards": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["camera", "ethernet", "battery"]}},
        "tags": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 50}},
        "license": {"type": "string", "maxLength": 500},
        "external_links": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["label", "url", "platform"], "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?://"},
          "platform": {"enum": ["github", "oshwhub", "makerworld", "other"]}
        }}}
      }
    },
    "content": {
      "type": "object", "additionalProperties": false, "required": ["readme"],
      "properties": {
        "readme": {"$ref": "#/$defs/path"},
        "covers": {"type": "array", "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "resources": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "attachments": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "release": {"type": "object", "additionalProperties": false, "properties": {"changelog": {"type": "string", "maxLength": 10000}}}
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "maxLength": 1024, "description": "Application-relative file; runtime also rejects absolute paths, .. traversal, escaping symlinks and duplicate files."}}
}
